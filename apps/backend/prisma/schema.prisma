// ============================================================
// PRISMA SCHEMA - Complete database schema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  user
  admin
}

enum ExecutionStatus {
  pending
  running
  completed
  failed
  timeout
  memory_limit
}

enum Language {
  python
  javascript
  cpp
  java
  verilog
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  username      String    @unique
  password      String
  avatar        String?
  role          Role      @default(user)
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedRooms         Room[]               @relation("RoomOwner")
  roomMemberships    RoomMembership[]
  executionJobs      ExecutionJob[]
  executionHistory   ExecutionHistory[]
  aiConversations    AIConversation[]
  refreshTokens      RefreshToken[]

  @@map("users")
}

model Room {
  id          String   @id @default(uuid())
  name        String
  description String?
  language    Language @default(python)
  code        String   @default("")
  version     Int      @default(0)
  isPublic    Boolean  @default(true)
  isActive    Boolean  @default(true)
  maxUsers    Int      @default(10)
  ownerId     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  owner            User               @relation("RoomOwner", fields: [ownerId], references: [id])
  memberships      RoomMembership[]
  executionJobs    ExecutionJob[]
  executionHistory ExecutionHistory[]
  aiConversations  AIConversation[]
  sessions         CollaborationSession[]

  @@map("rooms")
}

model RoomMembership {
  id        String   @id @default(uuid())
  userId    String
  roomId    String
  role      String   @default("member")
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([userId, roomId])
  @@map("room_memberships")
}

model CollaborationSession {
  id          String    @id @default(uuid())
  roomId      String
  userId      String
  socketId    String
  connectedAt DateTime  @default(now())
  leftAt      DateTime?

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@map("collaboration_sessions")
}

model ExecutionJob {
  id          String          @id @default(uuid())
  roomId      String
  userId      String
  code        String
  language    Language
  stdin       String?
  status      ExecutionStatus @default(pending)
  priority    Int             @default(0)
  queuedAt    DateTime        @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime        @default(now())

  room    Room             @relation(fields: [roomId], references: [id])
  user    User             @relation(fields: [userId], references: [id])
  history ExecutionHistory?

  @@map("execution_jobs")
}

model ExecutionHistory {
  id             String          @id @default(uuid())
  jobId          String          @unique
  roomId         String
  userId         String
  code           String
  language       Language
  stdin          String?
  stdout         String?
  stderr         String?
  exitCode       Int?
  executionTime  Float?
  memoryUsed     Float?
  status         ExecutionStatus
  errorMessage   String?
  createdAt      DateTime        @default(now())

  job  ExecutionJob @relation(fields: [jobId], references: [id])
  room Room         @relation(fields: [roomId], references: [id])
  user User         @relation(fields: [userId], references: [id])

  @@map("execution_history")
}

model AIConversation {
  id        String      @id @default(uuid())
  roomId    String
  userId    String
  title     String?
  messages  Json        @default("[]")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  room Room @relation(fields: [roomId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@map("ai_conversations")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model Analytics {
  id                String   @id @default(uuid())
  date              DateTime @default(now()) @db.Date
  totalExecutions   Int      @default(0)
  successCount      Int      @default(0)
  failureCount      Int      @default(0)
  timeoutCount      Int      @default(0)
  avgExecutionTime  Float    @default(0)
  activeUsers       Int      @default(0)
  activeRooms       Int      @default(0)
  languageCounts    Json     @default("{}")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([date])
  @@map("analytics")
}
